# tracking-server environment variables. Copy to `.env` for local dev
# (or use `op run` if you've adopted 1Password) and to DO App Platform
# secrets for production.

# HTTP listener
PORT=4100

# Redis used as the BullMQ transport for analyticsEventsQueue. Use the
# same Upstash / DO Managed Redis instance the other services share.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Salt for the daily visitor hash. Rotate to invalidate all historical
# visitor identifiers (e.g. on a privacy incident). Keep stable
# otherwise — rotation resets visitor timelines.
VISITOR_HASH_SALT=hoizr-visitor

# CORS allow-list. Customer storefront origins only; business/admin/artist
# consoles do not post customer behavior events here. Localhost is auto-allowed
# by the server for SDK integration testing.
TRACKING_CORS_ORIGINS=https://www.hoizr.com,https://hoizr.com,https://dev.hoizr.com,https://dev-customer.hoizr.com
